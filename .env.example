# Self-test model provider. `codex` delegates to the locally logged-in Codex CLI;
# leave AGENT_MODEL blank to use that CLI's configured default model.
AGENT_PROVIDER=codex
AGENT_MODEL=
# CLI/terminal Agent 的单轮上限；保留较长时间以兼容手动复杂研究。
AGENT_CODEX_TIMEOUT_SECONDS=120
# Web 入口的单轮上限；网页采用更短预算，已知证券会先走无需模型的快速路径。
AGENT_WEB_CODEX_TIMEOUT_SECONDS=35
AGENT_QIANFAN_TIMEOUT_SECONDS=60
AGENT_BAILIAN_TIMEOUT_SECONDS=60
# Optional HTTPS override. Leave blank to derive the recommended workspace
# endpoint from BAILIAN_WORKSPACE_ID.
AGENT_BAILIAN_BASE_URL=
AGENT_MEMORY_WINDOW=20
# The Web workspace keeps short-term conversation Agents only. Idle sessions
# expire after this period, and the least-recently-used idle session is evicted
# when the cache reaches its capacity.
AGENT_WEB_CONVERSATION_TTL_SECONDS=1800
AGENT_WEB_MAX_CONVERSATIONS=50
# Server-side diagnostic logs are JSON Lines. By default they are written to
# %LOCALAPPDATA%\FinanceAgent\logs\finance-agent.jsonl. Override the directory
# only when the service account has write access; never use a shared public path.
AGENT_LOG_LEVEL=INFO
AGENT_LOG_DIR=

# Tencent ima private knowledge-base search. Keep the credentials out of Git;
# the application also supports the current user's DPAPI-protected token store.
# Target configuration: use an opaque ID for a fixed default, or a readable
# exact name for a lazily resolved target. An ID takes precedence when both
# are provided. The application can also retain a default ID in the current
# user's DPAPI-protected token store.
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
IMA_KNOWLEDGE_BASE_ID=
IMA_KNOWLEDGE_BASE_NAME=

# Optional Qianfan LLM provider. Prefer: finance-agent source set-token qianfan
QIANFAN_API_KEY=
# Optional Alibaba Cloud Bailian (Model Studio) LLM provider.
BAILIAN_API_KEY=
BAILIAN_WORKSPACE_ID=

# Keep this file secret-free. Prefer: finance-agent source set-token alltick
# This variable is only for an ephemeral process or deployment environment.
ALLTICK_API_TOKEN=

# Prefer: finance-agent source set-token tickflow.  TickFlow's SDK is used for
# date-bounded daily OHLCV and provider-reported real-time quote snapshots.
TICKFLOW_API_KEY=

# Prefer: finance-agent source set-token zhitu. 智兔数服 supports documented
# A-share / 沪深指数 real-time snapshots and date-bounded daily history.
ZHITU_API_KEY=

# Prefer: ai-agent source set-token alphavantage
ALPHAVANTAGE_API_KEY=

# Prefer: ai-agent source set-token eodhd
EODHD_API_TOKEN=

# Prefer: ai-agent source set-token biying
BIYING_API_LICENCE=

# AkTools is an optional locally hosted AKShare service, not a token-authenticated API.
AKTOOLS_BASE_URL=http://127.0.0.1:8080
# Optional maintenance-only credential slot; it is not read by the current AkTools adapter.
AKTOOLS_API_TOKEN=

# Optional maintenance-only credential slots; these sources do not currently authenticate with tokens.
BAOSTOCK_API_TOKEN=
YFINANCE_API_TOKEN=

# Optional: keep yfinance timezone/cookie cache outside the user profile.
YFINANCE_CACHE_DIR=G:\Program Files\Codex\finance-agent\resources\cache\yfinance

# To reserve a maintenance slot for a future source, add its declaration to
# src/ai_agent/data_sources.py first. Then add its optional environment-variable
# placeholder here; the source CLI commands are generated from the catalog.
# Backend service mode. Set production only after configuring every required secret.
AGENT_ENV=development
# At least 32 characters. Required when AGENT_ENV=production.
AGENT_SESSION_SECRET=
# Configured only on the server; never include these in a mini-program build.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Personal launch mode: only listed opaque internal user IDs may sign in.
# Bootstrap the ID once in development from the login response, then set this
# to true and deploy with the ID in the service environment.
AGENT_PERSONAL_MODE=false
AGENT_ALLOWED_USER_IDS=
# The mini-program's optional evidence-bound prose layer. `codex` uses the
# current model selected by the locally signed-in Codex CLI when AGENT_MODEL is blank.
# Set to qianfan only when you explicitly want the Qianfan provider instead.
AGENT_API_NARRATOR_PROVIDER=codex
AGENT_QIANFAN_MODEL=ernie-4.5-turbo-32k
AGENT_BAILIAN_MODEL=qwen-plus
# Development server bind address and port.
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=8000
# Keep true for the combined local entry at /web/. Set false when a static host
# deploys web/ independently; API-only mode does not require the web directory.
AGENT_SERVE_WEB=true
# Exact comma-separated Web origins allowed to call an independently deployed
# API, without paths or wildcards. Leave blank for the same-origin local mode.
AGENT_WEB_ALLOWED_ORIGINS=
# Personal Web workspace access. Leave blank only while the API binds to the
# loopback host above. For any remote bind or reverse proxy, set a long random
# value and enter the same value in the Web workspace connection panel.
AGENT_WEB_ACCESS_TOKEN=
# On-demand source smoke tests. The settings page does not probe automatically;
# each remote test is read-only but may consume one provider request.
AGENT_SOURCE_CHECK_TIMEOUT_SECONDS=4
AGENT_SOURCE_CHECK_MAX_PARALLEL=4
