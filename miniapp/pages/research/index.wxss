.page {
  padding-bottom: 130rpx;
}

.intro .title,
.clarification .title {
  font-size: 32rpx;
  font-weight: 600;
}

.caption,
.options,
.task {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.message {
  max-width: 82%;
  margin: 20rpx 24rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  white-space: pre-wrap;
}

.message.user {
  margin-left: auto;
  background: var(--green-soft);
}

.message.assistant {
  background: var(--paper);
}

.clarification-item {
  margin-top: 18rpx;
}

.composer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: var(--paper);
  border-top: 1rpx solid var(--line);
}

.composer input {
  flex: 1;
  min-height: 72rpx;
  padding: 0 20rpx;
  background: var(--surface-muted);
  border-radius: 12rpx;
}

.composer button {
  margin: 0;
  font-size: 26rpx;
}
