.page {
  padding-bottom: 130rpx;
}

.intro .title,
.clarification .title {
  font-size: 32rpx;
  font-weight: 600;
}

.caption,
.options,
.task {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 24rpx;
}

.message {
  max-width: 82%;
  margin: 20rpx 24rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  white-space: pre-wrap;
}

.message.user {
  margin-left: auto;
  background: #ccfbf1;
}

.message.assistant {
  background: #ffffff;
}

.clarification-item {
  margin-top: 18rpx;
}

.composer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #e2e8f0;
}

.composer input {
  flex: 1;
  min-height: 72rpx;
  padding: 0 20rpx;
  background: #f1f5f9;
  border-radius: 12rpx;
}

.composer button {
  margin: 0;
  font-size: 26rpx;
}
