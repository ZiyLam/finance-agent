.title,
.heading {
  font-size: 32rpx;
  font-weight: 600;
}

.heading {
  margin-bottom: 16rpx;
}

.meta {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 25rpx;
}

.observation,
.risk {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}

.risk {
  color: var(--warning-strong);
}

.error {
  color: var(--danger);
}

.disclaimer {
  color: var(--muted);
  font-size: 24rpx;
}
