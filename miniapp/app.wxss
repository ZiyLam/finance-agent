@import "./styles/design-tokens.wxss";

page {
  min-height: 100%;
  background: var(--canvas);
  color: var(--ink);
  font-size: 28rpx;
}

button {
  border-radius: 14rpx;
}

.card {
  margin: 24rpx;
  padding: 28rpx;
  background: var(--paper);
  border-radius: 18rpx;
  box-shadow: 0 8rpx 30rpx rgba(15, 23, 42, 0.06);
}
