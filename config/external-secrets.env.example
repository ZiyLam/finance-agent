# Finance Agent external credential bundle v1
#
# Purpose: this file is the committed key-name contract and formatting template.
# It contains no real value. Keep the real bundle outside the Git repository.
#
# Format rules:
# - UTF-8 without BOM; one KEY=VALUE record per line.
# - Keys use uppercase ASCII letters, numbers, and underscores.
# - Do not add spaces around '=' and do not wrap values in quotes.
# - Blank values mean "not configured" and are omitted from Kubernetes Secret.
# - Lines beginning with '#' and blank lines are comments/section separators.
# - Inline comments are not supported: text after '=' is always value data.
# - Duplicate keys, export syntax, and unknown keys are rejected.
# - A value may contain '=' or '#'; everything after the first '=' is the value.

# Market-data provider credentials
ALLTICK_API_TOKEN=
ALPHAVANTAGE_API_KEY=
BIYING_API_LICENCE=
EODHD_API_TOKEN=
TICKFLOW_API_KEY=
ZHITU_API_KEY=
AKTOOLS_API_TOKEN=

# LLM provider credentials
QIANFAN_API_KEY=
BAILIAN_API_KEY=

# Tencent ima OpenAPI credentials and opaque knowledge-base target
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
IMA_KNOWLEDGE_BASE_ID=

# Optional server-side mini-program credential
WECHAT_APP_SECRET=
